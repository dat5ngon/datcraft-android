<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- Drag handle bar at the top -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#DD1a1a2e"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/go_back"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#AAAAAA"
            android:scaleType="centerInside" />

        <!-- Drag indicator -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_weight="0"
            android:background="#555"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Swap sides button -->
        <ImageButton
            android:id="@+id/btnSwapSide"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/swap_sides"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#AAAAAA"
            android:scaleType="centerInside" />

        <!-- Minimize button -->
        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minimize"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#AAAAAA"
            android:scaleType="centerInside" />

        <!-- Full screen (dismiss overlay, return to full-screen WebView) -->
        <ImageButton
            android:id="@+id/btnFullScreen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/full_screen"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#AAAAAA"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- WebView fills the rest -->
    <WebView
        android:id="@+id/floatingWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="36dp" />

</FrameLayout>
