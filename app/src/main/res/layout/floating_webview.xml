<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- WebView fills the entire overlay -->
    <WebView
        android:id="@+id/floatingWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Vertical floating toolbar pill, positioned on the edge -->
    <LinearLayout
        android:id="@+id/toolbarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:background="@drawable/toolbar_pill_bg"
        android:elevation="8dp"
        android:padding="4dp">

        <!-- Home button -->
        <TextView
            android:id="@+id/btnHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#444444"
            android:textSize="28sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/go_home" />

        <!-- Swap sides button -->
        <TextView
            android:id="@+id/btnSwapSide"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⇄"
            android:textColor="#444444"
            android:textSize="20sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/swap_sides" />

        <!-- Full screen button (highlighted, like the blue arrow in the reference) -->
        <TextView
            android:id="@+id/btnFullScreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⛶"
            android:textColor="#4285F4"
            android:textSize="22sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/full_screen" />

        <!-- Drag handle (for repositioning) -->
        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⠿"
            android:textColor="#888888"
            android:textSize="22sp"
            android:contentDescription="@string/drag_handle" />

        <!-- Minimize / close button -->
        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="#444444"
            android:textSize="20sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/minimize" />

    </LinearLayout>

</FrameLayout>
